# Copy to .env (never commit .env)
PORT=3000

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin role is NOT configured here. Set it in MySQL only:
#   UPDATE users SET role = 'admin' WHERE email = 'someone@example.com';

# Only needed if the frontend is served from a different origin than the API
# (e.g. VS Code Live Server). Comma-separated.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# MySQL (required). Use a limited app user, not root. seed.sql creates 'tunton_app': change its password before deploying.
DB_HOST=localhost
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=tunton


# ---- Port forwarding / tunnels (optional) ----
# The public https address people use (VS Code Ports, ngrok, cloudflared...). Only used to print what to register in Google Cloud.
# Google sign-in works only from origins listed under "Authorized JavaScript origins", so use a tunnel with a STABLE address
# (ngrok static domain, VS Code persistent dev tunnel, cloudflared named tunnel), not a random one that changes each run.
PUBLIC_URL=
# Proxies allowed to set X-Forwarded-For. Default (blank) trusts only tunnel agents running on this machine.
TRUST_PROXY=
# Serve https directly (for http://192.168.x.x style forwarding, where GPS and Google need https). Make certs with mkcert.
SSL_KEY_FILE=
SSL_CERT_FILE=

# Sent to OpenStreetMap when this server fetches map tiles (their usage policy asks apps to identify themselves). Optional.
TILE_USER_AGENT=
